# Auto detect text files and perform LF normalization
* text=auto

# Force CRLF for C# files (Windows standard)
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# Force LF for shell scripts
*.sh text eol=lf

# Binary files
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
